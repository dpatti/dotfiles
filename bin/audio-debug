#!/usr/bin/env bash
set -uo pipefail

commands=(
  "systemctl --no-pager --user status wireplumber.service pipewire-pulse.socket pipewire.socket"
  "pactl get-default-sink"
  "pactl get-default-source"
  "pactl list sinks | rg 'Name:|Description:|priority.session'"
  "pactl list cards | sed -r -n '/Name:/p; /Profiles:/,/Active Profile:/p; /^$/p; /\[(In|Out)\]/p; /Part of profile/p'"
  "wpctl status"
  "pactl upload-sample /usr/share/sounds/alsa/Noise.wav; pactl play-sample Noise"
)

for run in "${commands[@]}"; do
  echo "========== $run =========="
  eval "command $run"
  echo "===========$(sed 's/./=/g' <<< "$run")==========="
  echo
done

echo "Hint: pactl set-card-profile <card> <profile>"
echo "e.g., pactl set-card-profile alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic 'HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)'"
echo "      pactl set-card-profile alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic 'HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)'"
